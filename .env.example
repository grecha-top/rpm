TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LOOP=false
TELEGRAM_ALERT_INTERVAL=30s
TELEGRAM_ALERT_LIMIT=20
